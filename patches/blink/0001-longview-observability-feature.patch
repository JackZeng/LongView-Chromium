From 61fe8ed95d57b73c7bfdde0eaa07f58d7f5e8c8d Mon Sep 17 00:00:00 2001
From: LongView Chromium <longview@example.invalid>
Date: Sun, 16 Aug 2026 15:00:00 +0800
Subject: [PATCH 1/1] Blink: add disabled LongView lifecycle observability feature

Add a disabled-by-default runtime-enabled feature for the first native
LongView observability probe. Chromium generates the renderer accessor and
matching base::Feature from this JSON5 entry. No rendering behavior changes.
---
 .../renderer/platform/runtime_enabled_features.json5 | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/third_party/blink/renderer/platform/runtime_enabled_features.json5 b/third_party/blink/renderer/platform/runtime_enabled_features.json5
--- a/third_party/blink/renderer/platform/runtime_enabled_features.json5
+++ b/third_party/blink/renderer/platform/runtime_enabled_features.json5
@@
   data: [
+  {
+    // LongView: document-scoped long-page lifecycle observability.
+    name: "LongViewSegmentLifecycle",
+    base_feature_status: "disabled",
+    public: true,
+  },
