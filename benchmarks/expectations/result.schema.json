{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LongView benchmark report",
  "type": "object",
  "required": [
    "schemaVersion",
    "metadata",
    "summary",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "metadata": {
      "type": "object",
      "required": [
        "generatedAt",
        "executable",
        "longview",
        "turns",
        "duration",
        "host",
        "browserVersion",
        "tracing",
        "headless",
        "fixtureTransport",
        "publishableEvidence"
      ],
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "browserVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "longview": {
          "type": "boolean"
        },
        "turns": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000
        },
        "stream": {
          "type": "boolean"
        },
        "stress": {
          "type": "boolean"
        },
        "duration": {
          "type": "number",
          "minimum": 1000
        },
        "tracing": {
          "type": "boolean"
        },
        "host": {
          "type": "object",
          "required": [
            "platform",
            "release",
            "arch",
            "logicalCpus",
            "totalMemoryBytes",
            "node"
          ]
        },
        "fixtureTransport": {
          "enum": [
            "http",
            "inline-smoke"
          ]
        },
        "publishableEvidence": {
          "type": "boolean"
        },
        "headless": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "runCount",
        "medianP50FrameTime",
        "medianP95FrameTime",
        "medianP99FrameTime",
        "medianDroppedFrameRatio",
        "medianLongTaskTime"
      ],
      "properties": {
        "runCount": {
          "type": "integer",
          "minimum": 1
        },
        "medianP50FrameTime": {
          "type": "number",
          "minimum": 0
        },
        "medianP95FrameTime": {
          "type": "number",
          "minimum": 0
        },
        "medianP99FrameTime": {
          "type": "number",
          "minimum": 0
        },
        "p95OfP95FrameTime": {
          "type": "number",
          "minimum": 0
        },
        "medianDroppedFrameRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "medianLongTaskTime": {
          "type": "number",
          "minimum": 0
        },
        "medianEstimatedRefreshHz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1
        },
        "medianUsedJSHeapSize": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "medianDOMNodes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "medianLayoutDuration": {
          "type": [
            "number",
            "null"
          ]
        },
        "medianRecalcStyleDuration": {
          "type": [
            "number",
            "null"
          ]
        },
        "medianScriptDuration": {
          "type": [
            "number",
            "null"
          ]
        },
        "medianTaskDuration": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "frameTime",
          "droppedFrameRatio",
          "longTasks",
          "correctness",
          "cdp"
        ],
        "properties": {
          "frameTime": {
            "type": "object",
            "required": [
              "p50",
              "p95",
              "p99",
              "max"
            ]
          },
          "droppedFrameRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "longTasks": {
            "type": "object"
          },
          "correctness": {
            "type": "object"
          },
          "cdp": {
            "type": "object",
            "required": [
              "before",
              "after",
              "delta"
            ]
          },
          "trace": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
